# Copy to .env and fill in. Never commit the filled-in file.

PORT=8787
# Relative to the repository root. Ignored under Docker, where compose pins it to /data/board.sqlite.
DATABASE_PATH=data/board.sqlite

# GitHub — your own copy of Superset, with your own issues in it
GITHUB_REPO=<your-account>/superset
# Fine-grained PAT on that repo, read-only: Issues, Pull requests, Contents, Checks, Metadata.
# Devin pushes branches and opens PRs through its own GitHub integration, not this token.
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
# Shared secret configured on the GitHub webhook
GITHUB_WEBHOOK_SECRET=

# Devin
DEVIN_API_BASE=https://api.devin.ai
DEVIN_API_KEY=
DEVIN_ORG_ID=
# Id of your own copy of docs/playbook.md (playbooks are org-scoped)
DEVIN_PLAYBOOK_ID=
DEVIN_MAX_ACU=20

# Where Devin sessions post phase callbacks — the tunnel hostname, not localhost
APP_BASE_URL=http://localhost:8787
CALLBACK_TOKEN=local-dev-callback-token

# Price of one ACU, used only for the board's cost estimate
ACU_RATE_USD=2.25

ISSUE_SYNC_INTERVAL_MS=60000
SESSION_POLL_INTERVAL_MS=10000

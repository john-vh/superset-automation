# Copy to .env and fill in. Never commit the filled-in file.

PORT=8787
# Relative to the repository root
DATABASE_PATH=data/board.sqlite

# GitHub
GITHUB_REPO=john-vh/superset
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
# Shared secret configured on the GitHub webhook
GITHUB_WEBHOOK_SECRET=

# Devin
DEVIN_API_BASE=https://api.devin.ai
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_PLAYBOOK_ID=
DEVIN_MAX_ACU=20

# Where Devin sessions post phase callbacks (a public tunnel URL when running locally)
APP_BASE_URL=http://localhost:8787
CALLBACK_TOKEN=local-dev-callback-token

# Price of one ACU, used only for the board's cost estimate
ACU_RATE_USD=2.25

ISSUE_SYNC_INTERVAL_MS=60000
SESSION_POLL_INTERVAL_MS=10000
